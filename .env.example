VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Server-side Vercel Function secret. Never prefix with VITE_.
GEMINI_API_KEY=
# Optional comma-separated model chain. The app tries each model until one works.
GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash,gemini-2.5-flash,gemini-2.5-flash-lite

# Client-side UI hint only. Enforce admin access in Firebase Security Rules.
VITE_ADMIN_UID=
